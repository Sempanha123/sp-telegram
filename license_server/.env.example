# PostgreSQL deployment database. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://sptelegram:CHANGE_ME@127.0.0.1:5432/sptelegram_license

# Long random server-only secrets.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
LICENSE_KEY_HASH_SECRET=replace-with-a-long-random-hmac-secret
DEVICE_ID_HASH_SECRET=replace-with-a-separate-random-hmac-secret

# Base64 of a raw 32-byte Ed25519 PRIVATE key. SERVER ONLY.
LICENSE_SIGNING_PRIVATE_KEY_B64=replace-with-server-private-key
LICENSE_SIGNING_KEY_ID=sp-license-v1

PUBLIC_BASE_URL=https://license.example.com
ALLOW_LOCAL_HTTP=false
OFFLINE_GRACE_DAYS=3
