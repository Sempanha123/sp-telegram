# Public desktop licensing configuration. This file must never contain server secrets.
# For local development run:
#   .\.venv\Scripts\python.exe scripts\configure_desktop_license.py
# The script derives the matching PUBLIC key locally from license_server\.env and never copies the private key here.
LICENSE_API_BASE_URL=https://license.example.com
SP_LICENSE_PUBLIC_KEY_B64=replace-with-ed25519-public-key
SP_APP_ENV=production
SP_ALLOW_LOCAL_LICENSE_HTTP=0
