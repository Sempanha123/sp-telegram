/* ============================================================
   SP Telegram — Modern Light Theme
   Crisp workspace surfaces with a light adaptive navigation rail,
   strong hierarchy, calm status colors, and native Qt controls.
   ============================================================ */

* {
    font-family: "Segoe UI", "Noto Sans Khmer", sans-serif;
    font-size: 13px;
    color: #172033;
}
QMainWindow, QWidget { background: #F5F7FB; color: #172033; }
QWidget#central_root { background: #F5F7FB; }

/* ---------- Sidebar ---------- */
QFrame#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #DDE3EE;
    border-radius: 0;
}
QFrame#sidebar_header { background: transparent; }
QWidget#sidebar_brand_text { background: transparent; }
QLabel#lbl_app_name {
    background: transparent;
    color: #172033;
    font-size: 16px;
    font-weight: 800;
}
QLabel[navSection="true"] { color: #8491A9; font-size: 10px; font-weight: 700; padding: 14px 10px 5px 10px; }
QPushButton[nav="true"] { min-height: 42px; text-align: left; background: transparent; border: 1px solid transparent; color: #475569; padding: 0 12px; border-radius: 9px; margin: 1px 3px; }
QPushButton[nav="true"]:hover { background: #F1F4FA; color: #172033; }
QPushButton[nav="true"]:focus { border-color: #A5B4FC; }
QPushButton[nav="true"]:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EEEAFE, stop:1 #F4F8FD); color: #4945A8; font-weight: 700; border-left: 3px solid #6D5FD0; }
QPushButton[nav="true"][collapsed="true"] { padding: 0; text-align: center; min-width: 44px; max-width: 44px; margin: 1px 2px; }
QLabel#lbl_sidebar_badge { background: #E9E7FD; color: #4446B8; border-radius: 8px; min-width: 16px; padding: 1px 5px; font-size: 10px; font-weight: 700; }
QLabel#lbl_brand_icon {
    background: transparent;
    border: 0;
}
QLabel#lbl_brand_edition { color: #6D5FD0; font-size: 9px; font-weight: 700; }
QPushButton#btn_toggle_sidebar { color: #56627A; }
QPushButton#btn_toggle_sidebar:hover { background: #F1F4FA; color: #172033; }
QFrame#sidebar QScrollArea { background: transparent; border: 0; }
QFrame#sidebar QScrollArea > QWidget > QWidget { background: transparent; }
QFrame#sidebar QScrollBar:vertical { background: transparent; }
QFrame#sidebar QScrollBar::handle:vertical { background: #C6CFE3; border-radius: 4px; }

/* ---------- Topbar ---------- */
QFrame#topbar { background: #FFFFFF; border-bottom: 1px solid #DDE3EE; min-height: 58px; }
QFrame#global_search_frame { background: #F1F4FA; border: 1px solid #DDE3EE; border-radius: 10px; }
QFrame#global_search_frame[active="true"] { border-color: #5B5CE2; background: #FFFFFF; }
QLineEdit#le_global_search { background: transparent; border: 0; min-height: 40px; max-height: 40px; padding: 0 2px; }
QPushButton#btn_search_shortcut { color: #64748B; background: #FFFFFF; border: 1px solid #C5CDDC; border-radius: 6px; min-width: 54px; min-height: 24px; max-height: 24px; padding: 0 8px; font-size: 10px; }
QPushButton#btn_search_shortcut:hover { color: #4446B8; background: #EEF0FE; border-color: #8B9BFF; }
QLabel[statusChip="true"] {
    background: #F8FAFD;
    border: 1px solid #DDE3EE;
    border-radius: 9px;
    padding: 4px 12px;
    color: #56627A;
    font-size: 11px;
    font-weight: 650;
}
QLabel[statusChip="true"][state="ok"] {
    color: #059669;
    background: #E8F5E8;
    border-color: #C8E6C9;
}
QLabel[statusChip="true"][state="warning"] {
    color: #D97706;
    background: #FFF8E1;
    border-color: #FFECB3;
}
QLabel[statusChip="true"][state="error"] {
    color: #E11D48;
    background: #FFEBF5;
    border-color: #FFCDD2;
}
QLabel[statusChip="true"][state="muted"] {
    color: #8491A9;
    background: #F1F4F9;
    border-color: #E0E0E0;
}

/* ---------- Cards ---------- */
QFrame[card="true"], QFrame[sectionCard="true"], QFrame[chartCard="true"], QGroupBox {
    background: #FFFFFF;
    border: 1px solid #DDE3EE;
    border-radius: 12px;
}
QFrame[card="true"]:hover, QFrame[sectionCard="true"]:hover, QFrame[chartCard="true"]:hover {
    border-color: #C5CDDC;
}
QFrame[sectionCard="true"] { border-top: 3px solid #5B5CE2; }
QFrame[chartCard="true"] { border-top: 3px solid #8B5CF6; }
QGroupBox { margin-top: 14px; padding-top: 15px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 5px; color: #56627A; }

/* ---------- Labels ---------- */
QLabel[muted="true"], QLabel#lbl_muted { color: #8491A9; }
QLabel[secondary="true"] { color: #56627A; }
QLabel[filterLabel="true"] { font-size: 10px; font-weight: 650; }
QLabel[emphasis="true"] { font-weight: 650; }
QLabel#lbl_page_title { color: #172033; font-size: 16px; font-weight: 700; }
QLabel#lbl_page_subtitle { color: #8491A9; font-size: 12px; }
QLabel#lbl_stat_value { font-size: 27px; font-weight: 700; color: #172033; }
QLabel[pageTitle="true"] { font-size: 23px; font-weight: 700; color: #111827; }
QLabel[pageSubtitle="true"] { color: #56627A; font-size: 12px; }
QLabel[dialogTitle="true"] { font-size: 18px; font-weight: 700; color: #172033; }
QLabel[dialogTitleLarge="true"] { font-size: 20px; font-weight: 700; color: #172033; }

QLabel[statusBadge="true"] { border-radius: 8px; padding: 0 12px; min-height: 28px; max-height: 28px; font-weight: 600; }
QLabel[capabilityBadge="true"] { border-radius: 8px; padding: 4px 10px; font-weight: 600; }
QLabel[statusBadge="true"][tone="success"], QLabel[capabilityBadge="true"][tone="success"] { background: #E7F8F1; color: #047857; }
QLabel[statusBadge="true"][tone="warning"], QLabel[capabilityBadge="true"][tone="warning"] { background: #FFF6E5; color: #B45309; }
QLabel[statusBadge="true"][tone="danger"], QLabel[capabilityBadge="true"][tone="danger"] { background: #FDECEF; color: #BE123C; }
QLabel[statusBadge="true"][tone="info"], QLabel[capabilityBadge="true"][tone="info"] { background: #E6F2FF; color: #0369A1; }
QLabel[statusBadge="true"][tone="muted"], QLabel[capabilityBadge="true"][tone="muted"] { background: #EEF2F7; color: #64748B; }

QStatusBar { background: #FFFFFF; color: #8491A9; border-top: 1px solid #DDE3EE; min-height: 24px; }
QToolTip { background: #1E1B4B; color: #FFFFFF; border: 0; padding: 6px 8px; border-radius: 6px; }
QMenu { background: #FFFFFF; border: 1px solid #C5CDDC; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 8px 30px 8px 10px; border-radius: 6px; }
QMenu::item:selected { background: #F0F1FC; color: #262B40; }
QMenu::separator { height: 1px; background: #E8EDF7; margin: 5px 8px; }
QScrollBar:vertical { width: 9px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical { background: #C6CFE3; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #A5B1CC; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 9px; background: transparent; margin: 2px; }
QScrollBar::handle:horizontal { background: #C6CFE3; border-radius: 4px; min-width: 28px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QDialog, QMessageBox { background: #FFFFFF; }
QSplitter::handle { background: #DDE3EE; }
QLabel#wizard_step_dot { border-radius: 12px; font-size: 11px; font-weight: 700; }
QLabel#wizard_step_dot[state="todo"] { background: #DDE3EE; color: #56627A; }
QLabel#wizard_step_dot[state="current"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5B5CE2, stop:1 #0891B2); color: #FFFFFF; }
QLabel#wizard_step_dot[state="done"] { background: #D5F6E8; color: #047857; }
QLineEdit#le_command_palette { font-size: 14px; min-height: 40px; }
QListWidget#list_command_palette { background: #FFFFFF; border: 1px solid #C5CDDC; border-radius: 9px; padding: 4px; }
QListWidget#list_command_palette::item { padding: 8px 10px; border-radius: 6px; }
QListWidget#list_command_palette::item:selected { background: #F0F1FC; color: #262B40; }

/* ---------- Buttons ---------- */
QPushButton {
    min-height: 36px;
    background: #FFFFFF;
    border: 1px solid #DDE3EE;
    border-radius: 9px;
    padding: 0 16px;
    font-weight: 550;
    color: #172033;
}
QPushButton:hover {
    background: #F8FAFD;
    border-color: #C5CDDC;
}
QPushButton:pressed {
    background: #EEF2F8;
}
QPushButton:disabled {
    color: #AEBACD;
    background: #F1F4F9;
    border-color: #E3E9F6;
}
QPushButton[primary="true"], QPushButton[role="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5B5CE2, stop:1 #0891B2);
    border-color: transparent; color: white; font-weight: 650;
}
QPushButton[primary="true"]:hover, QPushButton[role="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4F46E5, stop:1 #0284C7);
    border-color: transparent;
}
QPushButton[primary="true"]:pressed, QPushButton[role="primary"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4446B8, stop:1 #0369A1);
}
QPushButton[primary="true"]:disabled, QPushButton[role="primary"]:disabled { color: #BCC6E8; background: #E9E7FD; border-color: #DCD8F8; font-weight: 650; }
QPushButton[danger="true"], QPushButton[role="danger"] {
    background: #FFF0F5;
    border-color: #FAC6D3;
    color: #E11D48;
}
QPushButton[danger="true"]:hover, QPushButton[role="danger"]:hover {
    background: #FDE7ED;
    border-color: #E11D48;
}
QPushButton:focus { border: 1px solid #5B5CE2; }
QPushButton[primary="true"]:focus, QPushButton[role="primary"]:focus { border-color: #A5B4FC; }
QPushButton[danger="true"]:focus, QPushButton[role="danger"]:focus { border-color: #E11D48; }
QPushButton[role="ghost"] { background: transparent; border-color: transparent; color: #56627A; }
QPushButton[role="ghost"]:hover { background: #E9E7FD; color: #172033; }
QPushButton[role="ghost"]:focus { background: #F2F4FF; border-color: #5B5CE2; }
QPushButton[iconButton="true"] { min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px; padding: 0; }
QPushButton#btn_emergency_pause { min-width: 96px; background: #FFFFFF; border-color: #C5CDDC; color: #56627A; }
QPushButton#btn_emergency_pause[paused="true"] { background: #FEF3E1; border-color: #FCE2B8; color: #B45309; }

/* ---------- Inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QTimeEdit {
    min-height: 38px;
    background: #FFFFFF;
    border: 1px solid #DDE3EE;
    border-radius: 9px;
    padding: 0 14px;
    selection-background-color: #DDE0F6;
    selection-color: #172033;
    color: #172033;
}
QTextEdit, QPlainTextEdit { padding: 8px 14px; }
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover, QSpinBox:hover, QDateEdit:hover, QDateTimeEdit:hover, QTimeEdit:hover {
    border-color: #C5CDDC;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus, QTimeEdit:focus {
    border: 1px solid #5B5CE2;
    background: #FFFFFF;
}
QComboBox::drop-down { border: 0; width: 28px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #C5CDDC; selection-background-color: #F0F1FC; selection-color: #262B40; padding: 4px; outline: none; }
QComboBox[active="true"] { border: 1px solid #5B5CE2; background: #EEF0FE; color: #4446B8; font-weight: 600; }
QPushButton#btn_clear_filters { min-height: 36px; border: 1px solid #C5CDDC; border-radius: 8px; background: #FFFFFF; color: #56627A; padding: 0 12px; }
QPushButton#btn_clear_filters:hover { border-color: #B9C6DE; color: #172033; background: #F6F8FC; }

/* ---------- Page structures ---------- */
QFrame#page_header { background: transparent; border: 0; }
QFrame#page_toolbar, QFrame#filter_bar, QFrame#selection_bar { background: transparent; border: 0; }
QFrame#selection_bar { background: #FFFFFF; border: 1px solid #C5CDDC; border-radius: 9px; }
QPushButton#btn_table_tools { min-height: 36px; border: 1px solid #C5CDDC; border-radius: 8px; background: #FFFFFF; color: #334155; padding: 0 12px; }
QPushButton#btn_table_tools:hover { border-color: #5B5CE2; color: #24256D; background: #F3F1FF; }
QPushButton#btn_table_tools[active="true"] { color: #4C3EAF; border-color: #7770E8; background: #EEEAFE; }
QLabel#lbl_selection_count { color: #56627A; font-weight: 650; }

/* ---------- Tables ---------- */
QTableView {
    background: #FFFFFF;
    alternate-background-color: #FFFFFF;
    border: 1px solid #DDE3EE;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #F0F1FC;
    selection-color: #172033;
    outline: none;
}
QTableView:hover {
    border-color: #C5CDDC;
}
QTableView:focus { border-color: #5B5CE2; }
QTableView::item { border: 0; border-bottom: 1px solid #F1F4F9; padding: 0 12px; }
QTableView::item:hover { background: #F6F7FC; }
QTableView::item:selected { background: #F0F1FC; color: #262B40; }
QListView, QTreeView {
    selection-background-color: #F0F1FC;
    selection-color: #262B40;
    outline: none;
}
QListView::item:selected, QTreeView::item:selected { background: #F0F1FC; color: #262B40; }
QHeaderView::section {
    min-height: 40px;
    background: #F8FAFD;
    color: #56627A;
    border: 0;
    border-bottom: 1px solid #DDE3EE;
    padding: 0 12px;
    font-weight: 650;
}
QHeaderView::section:hover {
    background: #DDE3EE;
}
QTableCornerButton::section {
    background: #F8FAFD;
    border: 0;
    border-bottom: 1px solid #DDE3EE;
}

/* ---------- Tabs ---------- */
QTabWidget::pane { border: 0; background: transparent; top: -1px; }
QTabBar::tab {
    background: transparent;
    color: #8491A9;
    border: 0;
    padding: 10px 16px;
    margin-right: 3px;
    font-weight: 550;
    border-radius: 12px 12px 0 0;
}
QTabBar::tab:hover {
    color: #56627A;
    background: rgba(91, 92, 226, 18);
}
QTabBar::tab:selected {
    color: #4446B8;
    border-bottom: 2px solid #5B5CE2;
    background: rgba(91, 92, 226, 22);
}
QTabWidget#tab_settings QTabBar::tab {
    min-width: 150px;
    text-align: left;
    padding: 12px 16px;
    border-radius: 10px;
    margin: 2px 8px 2px 0;
}
QTabWidget#tab_settings QTabBar::tab:selected {
    background: #F0EFFC;
    border: 0;
    border-left: 2px solid #6D5FD0;
    color: #4446B8;
}
QWidget#page_settings { background: #F5F7FB; }
QLineEdit#le_settings_search:focus { border-color: #6D5FD0; background: #FFFFFF; }
QTabWidget#tab_settings::pane { background: #FFFFFF; border: 1px solid #D8DDF0; border-top: 2px solid #8B7CFF; border-radius: 14px; }
QScrollArea#settings_tab_scroll { background: #FFFFFF; border: 0; }
QScrollArea#settings_tab_scroll > QWidget > QWidget, QWidget#settings_tab_page { background: #FFFFFF; }

/* ---------- Cards and summaries ---------- */
QFrame[summaryCard="true"] {
    background: #FFFFFF;
    border: 1px solid #DDE3EE;
    border-radius: 16px;
    border-top: 3px solid #5B5CE2;
}
QFrame[summaryCard="true"]:hover {
}
QLabel[summaryLabel="true"] {
    color: #56627A;
    font-size: 11px;
    font-weight: 700;
    font-size: 10px;
}
QLabel[summaryValue="true"] {
    font-size: 32px;
    font-weight: 700;
    color: #4446B8;
}
QLabel[summaryMetric="true"] {
    color: #8491A9;
    font-size: 12px;
}
QFrame[systemBanner="true"] { background: #E8F7FA; border: 1px solid #B8E5EC; border-radius: 10px; }
QLabel[systemBannerText="true"] { font-weight: 650; color: #0E7490; }
QFrame[systemBanner="true"][state="attention"] { background: #FFF6E5; border-color: #F5D38A; }
QFrame[systemBanner="true"][state="attention"] QLabel[systemBannerText="true"] { color: #A85A05; }
QPushButton#btn_dashboard_review_attention { min-height: 28px; padding: 0 9px; color: #A85A05; }
QFrame#account_pool_summary { background: #FFFFFF; border: 1px solid #DDE3EE; border-radius: 12px; }
QWidget[accountSummaryItem="true"] { background: transparent; border: 0; }
QLabel[accountSummaryLabel="true"] { color: #8491A9; font-size: 11px; }
QLabel[summaryValueSmall="true"] { font-size: 15px; font-weight: 750; color: #4446B8; }
QLabel[summaryValueSmall="true"][tone="success"] { color: #0B9D6C; }
QLabel[summaryValueSmall="true"][tone="warning"] { color: #B45309; }
QLabel[summaryValueSmall="true"][tone="danger"] { color: #E11D48; }
QLabel[summaryValueSmall="true"][tone="primary"] { color: #4446B8; }
QLabel[summaryValueSmall="true"][tone="purple"] { color: #6D28D9; }
QLabel[summaryValueSmall="true"][tone="muted"] { color: #8491A9; }

/* Color-coded high-value actions keep dense multi-account screens scannable. */
QPushButton#btn_account_pool_safety { background: #F3EDFE; border-color: #DDD0FA; color: #6D28D9; }
QPushButton#btn_account_pool_safety:hover { background: #E7DBFB; border-color: #C9B5F5; }
QPushButton#btn_create_target_invite_link { background: #E3F8EF; border-color: #C6EEDA; color: #0B9D6C; }
QPushButton#btn_create_target_invite_link:hover { background: #D1F1E2; border-color: #A3E0C5; }
QPushButton#btn_create_target_campaign { background: #E7EFFE; border-color: #D3E2FC; color: #2563EB; }
QPushButton#btn_create_target_campaign:hover { background: #D7E5FD; border-color: #B0CDF9; }
QPushButton#btn_add_target_group, QPushButton#btn_add_source_group { background: #FEF3E1; border-color: #FCE2B8; color: #B45309; }
QPushButton#btn_add_target_group:hover, QPushButton#btn_add_source_group:hover { background: #FCE8C8; border-color: #F8D088; }
QPushButton#btn_target_more_actions, QPushButton#btn_source_more_actions { background: #EDF1F7; border-color: #C5CDDC; color: #475569; }
QPushButton#btn_target_more_actions:hover, QPushButton#btn_source_more_actions:hover { background: #E2E8F2; }

/* ---------- Empty state ---------- */
QFrame#empty_state {
    background: transparent;
    border: 1px dashed #5B5CE2;
    border-radius: 16px;
    padding: 32px;
    text-align: center;
}
QLabel#lbl_empty_icon {
    color: #5B5CE2;
    font-size: 48px;
    margin-bottom: 16px;
}
QLabel#lbl_empty_title {
    font-size: 18px;
    font-weight: 650;
    color: #4446B8;
    margin-bottom: 8px;
}
QLabel#lbl_empty_description {
    color: #8491A9;
    font-size: 14px;
    max-width: 200px;
}

/* ---------- Pagination ---------- */
QFrame#pagination_bar { background: transparent; border: 0; }
QLabel#lbl_pagination_total, QLabel#lbl_pagination_page { color: #8491A9; }
QPushButton#btn_page_previous, QPushButton#btn_page_next { min-height: 32px; }
QSpinBox#spin_page_jump { min-height: 32px; max-height: 32px; border-radius: 7px; font-weight: 650; color: #172033; }
QSpinBox#spin_page_jump::up-button, QSpinBox#spin_page_jump::down-button { width: 0; border: 0; }

/* ---------- Toast & loading ---------- */
QFrame#toast_notification { background: #FFFFFF; border: 1px solid #C5CDDC; border-radius: 11px; }
QLabel#lbl_toast_title { font-weight: 650; color: #172033; }
QLabel#lbl_toast_description { color: #56627A; }
QWidget#loading_overlay { background: rgba(243, 246, 252, 190); }
QFrame#loading_card { background: #FFFFFF; border: 1px solid #C5CDDC; border-radius: 12px; }
QProgressBar#loading_spinner { background: #DDE3EE; border: 0; border-radius: 2px; }
QProgressBar#loading_spinner::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5B5CE2, stop:1 #8B5CF6); border-radius: 2px; }

/* ---------- Checkboxes ---------- */
QCheckBox, QRadioButton { background: transparent; }
QCheckBox { spacing: 9px; min-height: 24px; color: #172033; }
QCheckBox[optionControl="true"] { background: transparent; border: 0; padding: 2px 0; }
QCheckBox::indicator { width: 20px; height: 20px; border: 1px solid #B9C6DE; border-radius: 5px; background: #FFFFFF; }
QCheckBox::indicator:hover { border-color: #5B5CE2; background: #EEF2FA; }
QCheckBox::indicator:checked { border-color: #6D5FD0; background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6659C5, stop:1 #168095); }
QCheckBox::indicator:disabled { border-color: #DDE3EE; background: #EEF2FA; }
QCheckBox[switch="true"] { spacing: 10px; }
QCheckBox[switch="true"]::indicator { width: 34px; height: 18px; border-radius: 9px; background: #C9D2E3; border: 0; }
QCheckBox[switch="true"]::indicator:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5B5CE2, stop:1 #8B5CF6); }

/* ---------- Progress bars ---------- */
QProgressBar { min-height: 8px; max-height: 8px; border: 0; border-radius: 4px; text-align: center; background: #E3E9F6; color: transparent; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5B5CE2, stop:1 #8B5CF6); border-radius: 4px; }
QProgressBar[tone="success"]::chunk { background: #10B981; }
QProgressBar[tone="warning"]::chunk { background: #F59E0B; }
QProgressBar[tone="danger"]::chunk { background: #F43F5E; }
QProgressBar[tone="muted"]::chunk { background: #8491A9; }

/* ---------- Tones ---------- */
QLabel[tone="success"] { color: #0B9D6C; }
QLabel[tone="warning"] { color: #B45309; }
QLabel[tone="danger"] { color: #E11D48; }
QLabel[tone="info"] { color: #0369A1; }
QLabel[tone="primary"] { color: #4446B8; }
QLabel[tone="purple"] { color: #6D28D9; }
QLabel[tone="muted"] { color: #8491A9; }
QCheckBox[switch="true"]::indicator { width: 0px; height: 0px; }

/* ---------- Licensing ---------- */
QLabel[planBadge="true"] { background: #E9E7FD; color: #4446B8; border: 1px solid #D8D4F9; border-radius: 7px; padding: 3px 7px; font-size: 10px; font-weight: 700; }
QFrame[pricingCard="true"] { background: #FFFFFF; border: 1px solid #DDE3EE; border-radius: 12px; }
QFrame[pricingCard="true"]:hover { border-color: #5B5CE2; }
QFrame[lockedFeature="true"] { background: #F6F8FD; border: 1px solid #DDE3EE; border-radius: 12px; }
QLabel[lockedTitle="true"], QLabel[sectionTitle="true"], QLabel[detailTitle="true"] { font-size: 16px; font-weight: 650; color: #172033; }
QLabel#lbl_loading_message { font-size: 14px; font-weight: 650; }

QPushButton#btn_license_status { min-height: 30px; padding: 0 9px; border-radius: 7px; background: #EEF2FA; border: 1px solid #DDE3EE; color: #56627A; font-size: 10px; font-weight: 700; }
QPushButton#btn_license_status[state="ok"] { color: #0B9D6C; border-color: #C6EEDA; background: #E3F8EF; }
QPushButton#btn_license_status[state="warning"] { color: #B45309; border-color: #FCE2B8; background: #FEF3E1; }
QPushButton#btn_license_status[state="error"] { color: #E11D48; border-color: #FAC6D3; background: #FDE7ED; }

/* ---------- Production polish ---------- */
QLabel { background: transparent; }
QWidget#summary_metrics_host, QWidget[transparentHost="true"] { background: transparent; border: 0; }
QWidget[metricTile="true"] { background: #FFFFFF; border: 1px solid #DDE3EE; border-radius: 8px; }
QLabel[metricValue="true"] { font-size: 18px; font-weight: 700; color: #172033; }
QLabel#lbl_summary_icon { color: #8491A9; }
QLabel[statusChip="true"], QPushButton#btn_license_status, QPushButton#btn_emergency_pause {
    min-height: 32px; max-height: 32px; padding: 0 12px; border-radius: 8px;
}
QTabWidget#tab_settings QTabBar::tab { min-width: 150px; min-height: 38px; }

/* ---------- Friendly modern accents ---------- */
QFrame[heroCard="true"] { background: #FFFFFF; border: 1px solid #DDE3EE; border-radius: 14px; }
QLabel[heroTitle="true"] { font-size: 18px; font-weight: 700; color: #111827; }
QLabel[heroSubtitle="true"] { color: #56627A; font-size: 12px; }
QFrame[accentCard="true"] { border-radius: 14px; border: 1px solid #DDE3EE; }
QFrame[accentCard="true"][accent="primary"] { background: #EEF0FE; border-top: 3px solid #5B5CE2; }
QFrame[accentCard="true"][accent="success"] { background: #E6F8F1; border-top: 3px solid #10B981; }
QFrame[accentCard="true"][accent="warning"] { background: #FEF5E6; border-top: 3px solid #F59E0B; }
QFrame[accentCard="true"][accent="danger"] { background: #FDEEF3; border-top: 3px solid #F43F5E; }
QFrame[accentCard="true"][accent="purple"] { background: #F3EDFE; border-top: 3px solid #8B5CF6; }
QFrame[accentCard="true"][accent="info"] { background: #E0F7FB; border-top: 3px solid #0891B2; }
QLabel[accentLabel="true"] { font-size: 11px; font-weight: 800; color: #475569; }
QLabel[accentValue="true"] { font-size: 26px; font-weight: 700; color: #111827; }
QLabel[accentValue="true"][accent="primary"] { color: #4446B8; }
QLabel[accentValue="true"][accent="success"] { color: #0B9D6C; }
QLabel[accentValue="true"][accent="warning"] { color: #B45309; }
QLabel[accentValue="true"][accent="danger"] { color: #E11D48; }
QLabel[accentValue="true"][accent="purple"] { color: #6D28D9; }
QLabel[accentValue="true"][accent="info"] { color: #0E7490; }
QLabel[accentLabel="true"] { color: #56627A; font-size: 11px; font-weight: 700; }

/* Live activity feed */
QFrame#activity_feed { background: #FFFFFF; border: 1px solid #DDE3EE; border-radius: 10px; }
QLabel[activityLine="true"] { padding: 2px 0; }
QLabel[activityLine="true"][level="info"] { color: #2563EB; }
QLabel[activityLine="true"][level="success"] { color: #0B9D6C; }
QLabel[activityLine="true"][level="warning"] { color: #B45309; }
QLabel[activityLine="true"][level="error"] { color: #E11D48; }
QLabel[activityLine="true"][level="muted"] { color: #8491A9; }


/* Job final result screen */
QFrame[resultBanner="true"] { border-radius: 12px; }
QFrame[resultBanner="true"][tone="success"] { background: #E6F8F1; border: 1px solid #A7F3D0; }
QFrame[resultBanner="true"][tone="warning"] { background: #FEF5E6; border: 1px solid #FDE68A; }
QFrame[resultBanner="true"][tone="danger"] { background: #FDEEF3; border: 1px solid #FECACA; }
QFrame[resultBanner="true"][tone="muted"] { background: #EEF2FA; border: 1px solid #DDE3EE; }
QLabel[resultHeadline="true"] { font-size: 20px; font-weight: 800; color: #0F172A; }
QLabel[resultSub="true"] { font-size: 12px; color: #56627A; }
QFrame[resultCell="true"] { border-radius: 10px; border: 1px solid #DDE3EE; background: #FFFFFF; }
QFrame[resultCell="true"][tone="primary"] { border-top: 3px solid #5B5CE2; }
QFrame[resultCell="true"][tone="success"] { border-top: 3px solid #10B981; }
QFrame[resultCell="true"][tone="warning"] { border-top: 3px solid #F59E0B; }
QFrame[resultCell="true"][tone="danger"] { border-top: 3px solid #F43F5E; }
QFrame[resultCell="true"][tone="muted"] { border-top: 3px solid #8491A9; }
QLabel[resultValue="true"] { font-size: 22px; font-weight: 800; }
QLabel[resultValue="true"][tone="primary"] { color: #4F46E5; }
QLabel[resultValue="true"][tone="success"] { color: #059669; }
QLabel[resultValue="true"][tone="warning"] { color: #D97706; }
QLabel[resultValue="true"][tone="danger"] { color: #E11D48; }
QLabel[resultValue="true"][tone="muted"] { color: #56627A; }
QLabel[resultLabel="true"] { font-size: 11px; font-weight: 700; color: #56627A; }
QLabel[resultPreview="true"] { background: #F6F8FC; border: 1px solid #DDE3EE; border-radius: 10px; padding: 12px; color: #334155; font-size: 12px; }

/* Premium license shell + celebration polish */
QPushButton#btn_license_status { min-width:84px; min-height:32px; max-height:32px; padding:0 12px; border-radius:9px; font-size:10px; font-weight:800; background:#F2F4FA; border:1px solid #D7DDEA; color:#536079; }
QPushButton#btn_license_status:hover { border-color:#7A7CF2; background:#EEF0FF; color:#3730A3; }
QPushButton#btn_license_status[state="ok"] { color:#087A58; border-color:#9EDDC6; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #E4F9F0,stop:1 #E9F5FF); }
QPushButton#btn_license_status[state="warning"] { color:#A75A08; border-color:#F0CC89; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FFF6DD,stop:1 #F5F1FF); }
QPushButton#btn_license_status[state="error"] { color:#C51D4A; border-color:#F1B5C5; background:#FFF0F4; }
QFrame[licenseHero="true"] { border:1px solid #CCD5E6; border-top:3px solid #635BDB; border-radius:14px; background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #FFFFFF,stop:0.55 #FAFBFF,stop:1 #F2FAFF); }
QFrame[pricingCard="true"][planTier="starter"] { border-top:2px solid #0EA5E9; }
QFrame[pricingCard="true"][planTier="pro"] { border-top:2px solid #6D5FD0; }
QFrame[pricingCard="true"][planTier="ultimate"] { border-top:2px solid #0891B2; }
QDialog#license_success_dialog { background:#F7F9FD; }
QFrame#license_success_hero { background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #EEECFF,stop:0.52 #EAF7FF,stop:1 #E8FAF2); border:1px solid #C8D5E7; border-radius:18px; }
QLabel[celebrationMark="true"] { color:#0A9A6B; font-size:38px; font-weight:900; }
QLabel[celebrationTitle="true"] { color:#182033; font-size:28px; font-weight:850; }
QLabel[celebrationSubtitle="true"] { color:#5F6D85; font-size:13px; }
QLabel[celebrationPlan="true"] { color:#5146B8; font-size:20px; font-weight:800; }
QFrame[licenseMetric="true"] { background:#FFFFFF; border:1px solid #DDE3EE; border-radius:12px; }
QLabel[licenseMetricValue="true"] { color:#172033; font-size:17px; font-weight:800; }
QLabel[licenseMetricCaption="true"] { color:#8491A9; font-size:9px; font-weight:750; }
QLabel[celebrationNote="true"] { color:#66738A; padding:4px 10px; }
QPushButton#btn_success_continue { min-width:190px; min-height:40px; }
QPushButton#btn_success_view_license { min-height:40px; background:#FFFFFF; border-color:#CCD5E6; }

/* Smart Add Members simple flow */
QDialog#dlg_smart_add_members { background: #F7F9FD; }
QFrame#smart_add_hero {
    border: 1px solid #C9D8E8;
    border-left: 3px solid #0891B2;
    border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #FFFFFF,stop:0.55 #F2F8FF,stop:1 #ECFAF9);
}
QLabel#smart_add_title { color: #172033; font-size: 23px; font-weight: 800; }
QLabel#smart_add_subtitle, QLabel#smart_add_muted { color: #66758D; }
QLabel#smart_add_caption { color: #087E9A; font-size: 10px; font-weight: 800; }
QLabel#smart_add_section_title { color: #182033; font-size: 15px; font-weight: 750; }
QLabel#smart_add_status {
    padding: 10px 12px; border-radius: 9px;
    background: #FFFFFF; border: 1px solid #D8E0EB; color: #53627A;
}
QFrame#smart_add_target_card {
    border: 1px solid #D8E0EB; border-radius: 12px; background: #FFFFFF;
}
QFrame[smartStage="true"] {
    border: 1px solid #D9E1EC; border-radius: 9px; background: #FFFFFF;
}
QLabel[stageBadge="true"] {
    min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px;
    border-radius: 12px; background: #E8F6FA; color: #087E9A; font-weight: 800;
}
QLabel[stageText="true"] { color: #56657C; font-weight: 700; }
QFrame[smartMetric="true"] {
    border: 1px solid #DCE3ED; border-radius: 11px; background: #FFFFFF;
}
QLabel[metricCaption="true"] { color: #8491A6; font-size: 10px; font-weight: 700; }
QLabel[metricValue="true"] { color: #172033; font-size: 20px; font-weight: 850; }
QPushButton#btn_smart_add_primary { min-width: 180px; min-height: 40px; }
QToolButton#btn_smart_add_advanced { color: #68778E; border: 0; padding: 4px 2px; }
QPlainTextEdit#smart_add_advanced { background: #FFFFFF; border: 1px solid #D8E0EB; border-radius: 9px; color: #65748B; }

/* Quick Add drag and drop flow */
QDialog#dlg_drag_drop_add { background: #F7F9FD; }
QFrame#quick_transfer_hero {
    border: 1px solid #C9D8E8; border-left: 3px solid #0891B2; border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #FFFFFF,stop:0.55 #F2F8FF,stop:1 #ECFAF9);
}
QLabel#quick_transfer_title { color: #172033; font-size: 24px; font-weight: 850; }
QLabel#quick_transfer_subtitle { color: #66758D; }
QLabel#quick_transfer_instruction { color: #56657C; font-size: 13px; font-weight: 750; padding: 6px; }
QFrame#quick_transfer_panel { background: #FFFFFF; border: 1px solid #D9E1EC; border-radius: 14px; }
QLabel#quick_transfer_panel_title { color: #172033; font-size: 13px; font-weight: 850; }
QFrame#drag_source_group_card, QFrame#drop_target_group_card { background: #FFFFFF; border: 1px solid #D8E0EB; border-radius: 12px; }
QFrame#drag_source_group_card:hover { border-color: #7A70DB; background: #F6F5FF; }
QFrame#drop_target_group_card:hover { border-color: #16A5C2; background: #F1FBFD; }
QFrame#drop_target_group_card[dropActive="true"] { border: 2px solid #0891B2; background: #EAFBFC; }
QFrame#drop_target_group_card[recommendedTarget="true"] { border-color: #27A77A; }
QLabel[flowBadge="source"] { color: #5146B8; background: #EEECFF; border-radius: 7px; padding: 3px 7px; font-size: 9px; font-weight: 800; }
QLabel[flowBadge="target"] { color: #087A58; background: #E6F8F0; border-radius: 7px; padding: 3px 7px; font-size: 9px; font-weight: 800; }
QLabel[dropHint="true"] { color: #087E9A; font-size: 9px; font-weight: 800; }
QLabel[flowCardTitle="true"] { color: #172033; font-size: 14px; font-weight: 800; }
QLabel[flowMuted="true"] { color: #728097; }
QLabel[flowCardMeta="true"] { color: #66758D; font-size: 10px; }
QLabel[flowEmpty="true"] { color: #8692A5; padding: 30px; }
QLabel#quick_transfer_arrow { color: #0891B2; font-size: 20px; font-weight: 900; }
QFrame#quick_transfer_route { border: 1px solid #D4DFEB; border-radius: 12px; background: #FFFFFF; }
QLabel#quick_route_source { color: #5146B8; font-size: 15px; font-weight: 800; }
QLabel#quick_route_target { color: #087A58; font-size: 15px; font-weight: 800; }
QLabel#quick_route_arrow { color: #0891B2; font-size: 24px; font-weight: 900; }
QLabel#quick_transfer_section_title { color: #172033; font-size: 14px; font-weight: 800; }
QFrame[flowMetric="true"] { background: #FFFFFF; border: 1px solid #DCE3ED; border-radius: 10px; }
QLabel[metricCaption="true"] { color: #8491A6; font-size: 9px; font-weight: 700; }
QLabel[metricValue="true"] { color: #172033; font-size: 19px; font-weight: 850; }
QLabel#quick_transfer_status { padding: 10px 12px; border-radius: 9px; background: #FFFFFF; border: 1px solid #D8E0EB; color: #53627A; }
QPushButton#btn_quick_transfer_primary { min-width: 180px; min-height: 40px; }
QToolButton#btn_quick_transfer_advanced { color: #68778E; border: 0; }
QPlainTextEdit#txt_quick_transfer_advanced { background: #FFFFFF; border: 1px solid #D8E0EB; border-radius: 9px; color: #65748B; }

/* Automation Studio V2 */
QWidget#page_automation_studio { background: transparent; }
QFrame#studio_hero {
    border: 1px solid #C9D8E8; border-left: 3px solid #0891B2; border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #FFFFFF,stop:.55 #F2F8FF,stop:1 #ECFAF9);
}
QLabel#studio_title { color: #172033; font-size: 24px; font-weight: 850; }
QLabel#studio_subtitle { color: #66758D; }
QLabel#studio_instruction { color: #596A81; font-size: 13px; font-weight: 800; padding: 4px; }
QFrame#studio_panel { background: #FFFFFF; border: 1px solid #D9E1EC; border-radius: 14px; }
QLabel#studio_panel_title { color: #172033; font-size: 13px; font-weight: 850; }
QLabel[studioMuted="true"] { color: #728097; }
QLabel[studioEmpty="true"] { color: #8692A5; padding: 34px; }
QLabel#studio_route_arrow { color: #0891B2; font-size: 20px; font-weight: 900; }
QLabel#studio_status {
    padding: 10px 12px; border-radius: 9px; background: #FFFFFF;
    border: 1px solid #D8E0EB; color: #53627A;
}

/* Live member job UX v2 */
QFrame#live_job_chip {
    background: #FFFFFF;
    border: 1px solid #CFD9E8;
    border-radius: 10px;
}
QFrame#live_job_chip[state="running"] {
    border-color: #0891B2;
    background: #ECFBFF;
}
QFrame#live_job_chip[state="success"] {
    border-color: #10B981;
    background: #ECFDF5;
}
QFrame#live_job_chip[state="warning"] {
    border-color: #D97706;
    background: #FFFBEB;
}
QFrame#live_job_chip[state="error"] {
    border-color: #E11D48;
    background: #FFF1F2;
}
QPushButton#btn_live_job_chip {
    border: 0;
    background: transparent;
    padding: 0px 5px;
    min-height: 24px;
    color: #164E63;
    font-size: 11px;
    font-weight: 800;
}
QProgressBar#progress_live_job_chip {
    border: 0;
    background: #DCE7F2;
    border-radius: 1px;
}
QProgressBar#progress_live_job_chip::chunk {
    background: #0891B2;
    border-radius: 1px;
}
QFrame#quick_live_activity {
    background: #FFFFFF;
    border: 1px solid #D5E0EC;
    border-left: 3px solid #0891B2;
    border-radius: 11px;
}
QLabel#lbl_quick_live_pulse {
    color: #0891B2;
    font-size: 22px;
    font-weight: 900;
}
QLabel#lbl_quick_live_title {
    color: #172033;
    font-size: 12px;
    font-weight: 850;
}
QLabel#lbl_quick_live_member {
    color: #27364D;
    font-size: 12px;
    font-weight: 750;
}
QLabel#lbl_quick_live_account {
    color: #087E9A;
    font-size: 11px;
    font-weight: 750;
}
QLabel#lbl_quick_live_feed {
    color: #718096;
    font-size: 10px;
}
QPushButton#btn_quick_background {
    min-height: 32px;
    padding: 5px 12px;
    border: 1px solid #C8D5E4;
    border-radius: 8px;
    background: #F8FBFF;
    color: #334155;
}
QPushButton#btn_quick_background:hover {
    border-color: #0891B2;
    background: #EDF9FF;
}

/* Group Board UX V2 */
QFrame#group_board_intro { background: #F8FCFF; border: 1px solid #D6E2EF; border-left: 3px solid #0891B2; border-radius: 12px; }
QLabel#lbl_group_board_heading { color: #172033; font-size: 20px; font-weight: 900; }
QLabel#lbl_group_board_description, QLabel#lbl_group_board_footer, QLabel#lbl_group_lane_subtitle { color: #64748B; }
QLineEdit#le_group_board_search { min-height: 38px; border: 1px solid #CBD8E7; border-radius: 9px; background: #FFFFFF; padding: 0 11px; }
QFrame#group_board_lane { background: #F8FAFD; border: 1px solid #D6E0EC; border-radius: 12px; }
QFrame#group_board_lane[dropActive="true"] { border: 2px solid #0891B2; background: #ECFBFF; }
QLabel#lbl_group_lane_title { color: #27364D; font-size: 12px; font-weight: 900; }
QLabel#lbl_group_lane_count { color: #0E7490; background: #E8F7FB; border: 1px solid #B5E2EC; border-radius: 9px; padding: 2px 7px; font-weight: 850; }
QLabel#lbl_group_lane_drop_hint { color: #0E7490; background: #EFFBFD; border: 1px dashed #7EC8D8; border-radius: 8px; font-size: 9px; font-weight: 850; }
QFrame#group_board_card { background: #FFFFFF; border: 1px solid #D5E0EC; border-radius: 10px; }
QFrame#group_board_card:hover { border-color: #0891B2; background: #F5FCFE; }
QFrame#group_board_card[role="source"] { border-left: 3px solid #7C3AED; }
QFrame#group_board_card[role="target"] { border-left: 3px solid #059669; }
QLabel#lbl_group_board_title { color: #172033; font-size: 12px; font-weight: 850; }
QLabel#lbl_group_board_subtitle { color: #087E9A; }
QLabel#lbl_group_board_meta { color: #718096; font-size: 10px; }
QLabel#lbl_group_board_badge { color: #334155; background: #F1F5F9; border: 1px solid #D7E0EA; border-radius: 7px; padding: 2px 6px; font-size: 8px; font-weight: 900; }

/* Add Member One-Board UX */
QWidget#page_add_member { background: transparent; }
QFrame#add_member_hero {
    border: 1px solid #CAD8E8; border-left: 3px solid #0891B2; border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #FFFFFF,stop:.58 #F2F8FF,stop:1 #ECFAF9);
}
QLabel#add_member_title { color: #172033; font-size: 24px; font-weight: 900; }
QLabel#add_member_subtitle { color: #64748B; }
QFrame#add_member_board_bar, QFrame#group_library_bar {
    background: #FFFFFF; border: 1px solid #D6E1ED; border-radius: 11px;
}
QLabel#lbl_add_member_board_title, QLabel#lbl_group_library_heading { color: #172033; font-size: 15px; font-weight: 900; }
QLabel#lbl_add_member_board_hint, QLabel#lbl_add_member_page_status, QLabel#lbl_group_library_hint { color: #64748B; }
QLabel#lbl_add_member_selection {
    color: #475569; background: #FFFFFF; border: 1px solid #D6E1ED; border-radius: 9px; padding: 9px 11px;
}
QFrame#add_member_group_card, QFrame#group_library_card {
    background: #FFFFFF; border: 1px solid #D5E0EC; border-radius: 11px;
}
QFrame#add_member_group_card:hover, QFrame#group_library_card:hover { border-color: #0891B2; background: #F5FCFE; }
QFrame#add_member_group_card[selectedSource="true"] { border: 2px solid #7C3AED; background: #F5F3FF; }
QFrame#add_member_group_card[dropActive="true"] { border: 2px solid #059669; background: #ECFDF5; }
QLabel#lbl_add_member_group_title, QLabel#lbl_group_library_title { color: #172033; font-size: 13px; font-weight: 850; }
QLabel#lbl_add_member_group_username, QLabel#lbl_group_library_username { color: #087E9A; }
QLabel#lbl_add_member_group_meta, QLabel#lbl_group_library_meta { color: #718096; font-size: 10px; }
QLabel#lbl_add_member_group_drag {
    color: #0E7490; background: #E8F7FB; border: 1px solid #B5E2EC;
    border-radius: 7px; padding: 2px 7px; font-size: 8px; font-weight: 900;
}

/* Add Member Left Right V2 */
QFrame#add_member_column {
    background: #F8FAFD;
    border: 1px solid #D6E0EC;
    border-radius: 12px;
}
QLabel#lbl_add_member_column_title {
    color: #172033;
    font-size: 13px;
    font-weight: 900;
}
QLabel#lbl_add_member_column_subtitle {
    color: #64748B;
}
QFrame#add_member_source_card,
QFrame#add_member_target_card {
    background: #FFFFFF;
    border: 1px solid #D5E0EC;
    border-radius: 10px;
}
QFrame#add_member_source_card:hover,
QFrame#add_member_source_card[selectedSource="true"] {
    border-color: #7C3AED;
    background: #F5F3FF;
}
QFrame#add_member_target_card:hover,
QFrame#add_member_target_card[dropActive="true"] {
    border-color: #059669;
    background: #ECFDF5;
}
QLabel#lbl_add_member_source_badge {
    color: #6D28D9;
    background: #F3E8FF;
    border: 1px solid #D8B4FE;
    border-radius: 7px;
    padding: 2px 7px;
    font-size: 8px;
    font-weight: 900;
}
QLabel#lbl_add_member_target_badge {
    color: #047857;
    background: #D1FAE5;
    border: 1px solid #A7F3D0;
    border-radius: 7px;
    padding: 2px 7px;
    font-size: 8px;
    font-weight: 900;
}
QLabel#lbl_add_member_arrow {
    color: #0891B2;
    font-size: 20px;
    font-weight: 900;
}

/* Add Member direct live activity V3 */
QFrame#live_job_chip { background: #FFFFFF; border: 1px solid #CFD9E8; border-radius: 10px; }
QFrame#live_job_chip[state="running"] { border-color: #0891B2; background: #ECFBFF; }
QFrame#live_job_chip[state="success"] { border-color: #10B981; background: #ECFDF5; }
QFrame#live_job_chip[state="warning"] { border-color: #D97706; background: #FFFBEB; }
QFrame#live_job_chip[state="error"] { border-color: #E11D48; background: #FFF1F2; }
QPushButton#btn_live_job_chip { border: 0; background: transparent; padding: 0px 5px; min-height: 24px; color: #164E63; font-size: 11px; font-weight: 800; }
QProgressBar#progress_live_job_chip { border: 0; background: #DCE7F2; border-radius: 1px; }
QProgressBar#progress_live_job_chip::chunk { background: #0891B2; border-radius: 1px; }
QFrame#quick_live_activity { background: #FFFFFF; border: 1px solid #D5E0EC; border-left: 3px solid #0891B2; border-radius: 11px; }
QLabel#lbl_quick_live_pulse { color: #0891B2; font-size: 22px; font-weight: 900; }
QLabel#lbl_quick_live_title { color: #172033; font-size: 12px; font-weight: 850; }
QLabel#lbl_quick_live_member { color: #27364D; font-size: 12px; font-weight: 800; }
QLabel#lbl_quick_live_account { color: #087E9A; font-size: 11px; font-weight: 750; }
QLabel#lbl_quick_live_feed { color: #718096; font-size: 10px; }
QPushButton#btn_quick_background, QPushButton#btn_quick_jobs { min-height: 31px; padding: 5px 11px; border: 1px solid #C8D5E4; border-radius: 8px; background: #F8FBFF; color: #334155; }
QPushButton#btn_quick_background:hover, QPushButton#btn_quick_jobs:hover { border-color: #0891B2; background: #EDF9FF; }

/* Add Member visible live activity V4 */
QFrame#add_member_live_activity {
    background: #FFFFFF;
    border: 1px solid #D5E0EC;
    border-left: 3px solid #0891B2;
    border-radius: 12px;
}
QLabel#lbl_add_live_pulse { color: #0891B2; font-size: 24px; font-weight: 900; }
QLabel#lbl_add_live_title { color: #172033; font-size: 13px; font-weight: 900; }
QLabel#lbl_add_live_current { color: #27364D; font-size: 12px; font-weight: 800; }
QLabel#lbl_add_live_via { color: #087E9A; font-size: 11px; font-weight: 750; }
QLabel#lbl_add_live_summary { color: #64748B; font-size: 10px; }
QFrame#add_live_accounts {
    background: #F8FBFF;
    border: 1px solid #D6E1ED;
    border-radius: 8px;
}
QLabel#lbl_add_live_account_name { color: #334155; font-weight: 750; }
QLabel#lbl_add_live_account_status { color: #087E9A; font-size: 10px; }
QLabel#lbl_add_live_account_assigned { color: #64748B; font-size: 10px; }
QLabel#lbl_add_live_feed { color: #718096; font-size: 10px; }
QProgressBar#progress_add_live {
    border: 0;
    background: #DCE7F2;
    border-radius: 2px;
}
QProgressBar#progress_add_live::chunk {
    background: #0891B2;
    border-radius: 2px;
}
QPushButton#btn_add_live_background, QPushButton#btn_add_live_jobs {
    min-height: 31px;
    padding: 5px 11px;
    border: 1px solid #C8D5E4;
    border-radius: 8px;
    background: #F8FBFF;
    color: #334155;
}
QPushButton#btn_add_live_background:hover, QPushButton#btn_add_live_jobs:hover {
    border-color: #0891B2;
    background: #EDF9FF;
}

/* Member Pool Add Members live activity V5 */
QFrame#add_member_live_activity {
    background:#FFFFFF; border:1px solid #D5E0EC; border-left:3px solid #0891B2;
    border-radius:12px;
}
QLabel#lbl_add_live_pulse { color:#0891B2; font-size:24px; font-weight:900; }
QLabel#lbl_add_live_title { color:#172033; font-size:13px; font-weight:900; }
QLabel#lbl_add_live_current { color:#27364D; font-size:12px; font-weight:800; }
QLabel#lbl_add_live_via { color:#087E9A; font-size:11px; font-weight:750; }
QLabel#lbl_add_live_summary { color:#64748B; font-size:10px; }
QFrame#add_live_accounts { background:#F8FBFF; border:1px solid #D6E1ED; border-radius:8px; }
QLabel#lbl_add_live_account_name { color:#334155; font-weight:750; }
QLabel#lbl_add_live_account_status { color:#087E9A; font-size:10px; }
QLabel#lbl_add_live_account_assigned { color:#64748B; font-size:10px; }
QLabel#lbl_add_live_feed { color:#718096; font-size:10px; }
QProgressBar#progress_add_live { border:0; background:#DCE7F2; border-radius:2px; }
QProgressBar#progress_add_live::chunk { background:#0891B2; border-radius:2px; }
QPushButton#btn_add_live_background, QPushButton#btn_add_live_jobs {
    min-height:31px; padding:5px 11px; border:1px solid #C8D5E4; border-radius:8px;
    background:#F8FBFF; color:#334155;
}
QPushButton#btn_add_live_background:hover, QPushButton#btn_add_live_jobs:hover {
    border-color:#0891B2; background:#EDF9FF;
}
