    background: #102A29;
}
QFrame#add_member_target_card[dropActive="true"] {
    border: 2px solid #22D3EE;
    background: #0D2C34;
}
QLabel#lbl_add_member_source_badge {
    color: #DDD6FE;
    background: #2D2350;
    border: 1px solid #5B47A2;
    border-radius: 7px;
    padding: 2px 7px;
    font-size: 8px;
    font-weight: 900;
}
QLabel#lbl_add_member_target_badge {
    color: #A7F3D0;
    background: #123B31;
    border: 1px solid #216C57;
    border-radius: 7px;
    padding: 2px 7px;
    font-size: 8px;
    font-weight: 900;
}
QFrame#add_member_arrow_lane {
    background: transparent;
    border: 0;
}
QLabel#lbl_add_member_arrow {
    color: #5FE1F3;
    font-size: 20px;
    font-weight: 900;
}

/* Add Member direct live activity V3 */
QFrame#live_job_chip { background: #0E1B2E; border: 1px solid #27405F; border-radius: 10px; }
QFrame#live_job_chip[state="running"] { border-color: #22D3EE; background: #0C2430; }
QFrame#live_job_chip[state="success"] { border-color: #34D399; background: #0D2A25; }
QFrame#live_job_chip[state="warning"] { border-color: #F59E0B; background: #2A2010; }
QFrame#live_job_chip[state="error"] { border-color: #FB7185; background: #2A151D; }
QPushButton#btn_live_job_chip { border: 0; background: transparent; padding: 0px 5px; min-height: 24px; color: #D9F7FF; font-size: 11px; font-weight: 800; }
QProgressBar#progress_live_job_chip { border: 0; background: #203049; border-radius: 1px; }
QProgressBar#progress_live_job_chip::chunk { background: #22D3EE; border-radius: 1px; }
QFrame#quick_live_activity { background: #0D192B; border: 1px solid #2C4363; border-left: 3px solid #22D3EE; border-radius: 11px; }
QLabel#lbl_quick_live_pulse { color: #22D3EE; font-size: 22px; font-weight: 900; }
QLabel#lbl_quick_live_title { color: #F5F9FF; font-size: 12px; font-weight: 850; }
QLabel#lbl_quick_live_member { color: #E8F2FF; font-size: 12px; font-weight: 800; }
QLabel#lbl_quick_live_account { color: #7DD3FC; font-size: 11px; font-weight: 750; }
QLabel#lbl_quick_live_feed { color: #90A5C0; font-size: 10px; }
QPushButton#btn_quick_background, QPushButton#btn_quick_jobs { min-height: 31px; padding: 5px 11px; border: 1px solid #355170; border-radius: 8px; background: #111F34; color: #D7E6F8; }
QPushButton#btn_quick_background:hover, QPushButton#btn_quick_jobs:hover { border-color: #22D3EE; background: #10283A; }

/* Add Member visible live activity V4 */
QFrame#add_member_live_activity {
    background: #0D192B;
    border: 1px solid #2D4769;
    border-left: 3px solid #22D3EE;
    border-radius: 12px;
}
QLabel#lbl_add_live_pulse { color: #22D3EE; font-size: 24px; font-weight: 900; }
QLabel#lbl_add_live_title { color: #F5F9FF; font-size: 13px; font-weight: 900; }
QLabel#lbl_add_live_current { color: #EEF6FF; font-size: 12px; font-weight: 800; }
QLabel#lbl_add_live_via { color: #7DD3FC; font-size: 11px; font-weight: 750; }
QLabel#lbl_add_live_summary { color: #9EB2CC; font-size: 10px; }
QFrame#add_live_accounts {
    background: #0A1423;
    border: 1px solid #223752;
    border-radius: 8px;
}
QLabel#lbl_add_live_account_name { color: #DDE9F8; font-weight: 750; }
QLabel#lbl_add_live_account_status { color: #8FE9F4; font-size: 10px; }
QLabel#lbl_add_live_account_assigned { color: #A7B9CF; font-size: 10px; }
QLabel#lbl_add_live_feed { color: #8198B7; font-size: 10px; }
QProgressBar#progress_add_live {
    border: 0;
    background: #203049;
    border-radius: 2px;
}
QProgressBar#progress_add_live::chunk {
    background: #22D3EE;
    border-radius: 2px;
}
QPushButton#btn_add_live_background, QPushButton#btn_add_live_jobs {
    min-height: 31px;
    padding: 5px 11px;
    border: 1px solid #355170;
    border-radius: 8px;
    background: #111F34;
    color: #D7E6F8;
}
QPushButton#btn_add_live_background:hover, QPushButton#btn_add_live_jobs:hover {
    border-color: #22D3EE;
    background: #10283A;
}

/* Member Pool Add Members live activity V5 */
QFrame#add_member_live_activity {
    background:#0D192B; border:1px solid #2D4769; border-left:3px solid #22D3EE;
    border-radius:12px;
}
QLabel#lbl_add_live_pulse { color:#22D3EE; font-size:24px; font-weight:900; }
QLabel#lbl_add_live_title { color:#F5F9FF; font-size:13px; font-weight:900; }
QLabel#lbl_add_live_current { color:#EEF6FF; font-size:12px; font-weight:800; }
QLabel#lbl_add_live_via { color:#7DD3FC; font-size:11px; font-weight:750; }
QLabel#lbl_add_live_summary { color:#9EB2CC; font-size:10px; }
QFrame#add_live_accounts { background:#0A1423; border:1px solid #223752; border-radius:8px; }
QLabel#lbl_add_live_account_name { color:#DDE9F8; font-weight:750; }
QLabel#lbl_add_live_account_status { color:#8FE9F4; font-size:10px; }
QLabel#lbl_add_live_account_assigned { color:#A7B9CF; font-size:10px; }
QLabel#lbl_add_live_feed { color:#8198B7; font-size:10px; }
QProgressBar#progress_add_live { border:0; background:#203049; border-radius:2px; }
QProgressBar#progress_add_live::chunk { background:#22D3EE; border-radius:2px; }
QPushButton#btn_add_live_background, QPushButton#btn_add_live_jobs {
    min-height:31px; padding:5px 11px; border:1px solid #355170; border-radius:8px;
    background:#111F34; color:#D7E6F8;
}
QPushButton#btn_add_live_background:hover, QPushButton#btn_add_live_jobs:hover {
    border-color:#22D3EE; background:#10283A;
}
