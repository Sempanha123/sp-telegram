/* Controls */
QLabel#wizard_step_dot { border-radius: 12px; font-size: 11px; font-weight: 700; }
QLabel#wizard_step_dot[state="todo"] { background: #18243C; color: #7F8BA6; }
QLabel#wizard_step_dot[state="current"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6D7CFF, stop:1 #22D3EE); color: #FFFFFF; }
QLabel#wizard_step_dot[state="done"] { background: #0D3A2C; color: #34D399; }
QLineEdit#le_command_palette { font-size: 14px; min-height: 40px; }
QListWidget#list_command_palette { background: #172036; border: 1px solid #2D3B59; border-radius: 9px; padding: 4px; }
QListWidget#list_command_palette::item { padding: 8px 10px; border-radius: 6px; }
QListWidget#list_command_palette::item:selected { background: #18243D; color: #F2F5FF; }
QPushButton {
    min-height: 36px;
    background: #141D32;
    border: 1px solid #2B3855;
    border-radius: 9px;
    padding: 0 16px;
    font-weight: 550;
}
QPushButton:hover {
    background: #1A253D;
    border-color: #405171;
}
QPushButton:pressed {
    background: #202C46;
}
QPushButton:disabled {
    color: #7F8BA6;
    background: #1A253D;
    border-color: #2B3855;
}
QPushButton[primary="true"], QPushButton[role="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6D7CFF, stop:1 #0891B2);
    border-color: transparent; color: #FFFFFF; font-weight: 700;
}
QPushButton[primary="true"]:hover, QPushButton[role="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7D8BFF, stop:1 #22D3EE);
    border-color: transparent;
}
QPushButton[primary="true"]:pressed, QPushButton[role="primary"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5667E8, stop:1 #087990);
}
QPushButton[primary="true"]:disabled, QPushButton[role="primary"]:disabled { color: #8D99B2; background: #1B2742; border-color: #2B3855; font-weight: 650; }
QPushButton[danger="true"], QPushButton[role="danger"] {
    background: #3A1724;
    border-color: #8E2C52;
    color: #FB7185;
}
QPushButton[danger="true"]:hover, QPushButton[role="danger"]:hover {
    background: #4A1A2C;
    border-color: #FB7185;
}
QPushButton:focus { border: 1px solid #8B9BFF; }
QPushButton[primary="true"]:focus, QPushButton[role="primary"]:focus { border-color: #C7D2FE; }
QPushButton[danger="true"]:focus, QPushButton[role="danger"]:focus { border-color: #FB7185; }
QPushButton[role="ghost"] { background: transparent; border-color: transparent; color: #B7C1D9; }
QPushButton[role="ghost"]:hover { background: #1B2742; color: #F5F7FF; }
QPushButton[role="ghost"]:focus { background: #172036; border-color: #8B9BFF; }
QPushButton[iconButton="true"] { min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px; padding: 0; }
QPushButton#btn_emergency_pause { min-width: 96px; background: #172036; border-color: #2D3B59; color: #B7C1D9; }
QPushButton#btn_emergency_pause[paused="true"] { background: #42300F; border-color: #8A6420; color: #FBBF24; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QTimeEdit {
    min-height: 38px;
    background: #11182B;
    border: 1px solid #2B3855;
    border-radius: 9px;
    padding: 0 14px;
    selection-background-color: #344466;
    selection-color: #FFFFFF;
}
QTextEdit, QPlainTextEdit { padding: 8px 14px; }
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover, QSpinBox:hover, QDateEdit:hover, QDateTimeEdit:hover, QTimeEdit:hover {
    border-color: #405171;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus, QTimeEdit:focus {
    border: 1px solid #8B9BFF;
    background: #11182B;
}
QComboBox::drop-down { border: 0; width: 28px; }
QComboBox QAbstractItemView { background: #172036; border: 1px solid #2D3B59; selection-background-color: #18243D; selection-color: #F2F5FF; padding: 4px; outline: none; }
QComboBox[active="true"] { border: 1px solid #7467D9; background: #171F36; color: #D8D4FF; font-weight: 600; }
QPushButton#btn_clear_filters { min-height: 36px; border: 1px solid #2B3855; border-radius: 8px; background: #11182B; color: #B7C1D9; padding: 0 12px; }
QPushButton#btn_clear_filters:hover { border-color: #405171; color: #EEF2FF; background: #172036; }
QPushButton#btn_table_tools { min-height: 36px; border: 1px solid #2B3855; border-radius: 8px; background: #11182B; color: #B7C1D9; padding: 0 12px; }
QPushButton#btn_table_tools:hover { border-color: #6D7CFF; color: #F5F7FF; background: #172036; }
QPushButton#btn_table_tools[active="true"] { color: #C4B5FD; border-color: #6658C7; background: #1D2341; }

/* Sidebar */
QFrame#sidebar_header { background: transparent; }
QWidget#sidebar_brand_text { background: transparent; }
QLabel#lbl_app_name { background: transparent; }
QFrame#sidebar QScrollArea { background: transparent; border: 0; }
QFrame#sidebar QScrollArea > QWidget > QWidget { background: transparent; }
QLabel[navSection="true"] {
    color: #91A1C4;
    font-size: 10px;
    font-weight: 700;
    padding: 14px 10px 5px 10px;
}
QPushButton[nav="true"] {
    min-height: 44px;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    color: #C2CAE0;
    padding: 0 14px;
    border-radius: 9px;
}
QPushButton[nav="true"]:hover {
    background: #141E33;
    color: #FFFFFF;
}
QPushButton[nav="true"]:focus { border: 1px solid #8B9BFF; }
QPushButton[nav="true"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #20264A, stop:1 #13283C);
    color: #F2F5FF;
    font-weight: 700;
    border-left: 3px solid #8B7CFF;
}
QPushButton[nav="true"][collapsed="true"] { padding: 0; text-align: center; min-width: 44px; max-width: 44px; }
QLabel#lbl_sidebar_badge {
    background: #8B9BFF;
    color: #FFFFFF;
    border-radius: 10px;
    min-width: 16px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#lbl_brand_icon {
    background: transparent;
    border: 0;
}
QLabel#lbl_brand_edition { color: #9D8CFF; font-size: 9px; font-weight: 700; }

/* Topbar */
QFrame#global_search_frame { background: #11182B; border: 1px solid #2B3855; border-radius: 10px; }
QFrame#global_search_frame[active="true"] { border-color: #8B9BFF; background: #121B30; }
QLineEdit#le_global_search { background: transparent; border: 0; min-height: 40px; max-height: 40px; padding: 0 2px; }
QPushButton#btn_search_shortcut { color: #9AA7C0; background: #172036; border: 1px solid #354563; border-radius: 6px; min-width: 54px; min-height: 24px; max-height: 24px; padding: 0 8px; font-size: 10px; }
QPushButton#btn_search_shortcut:hover { color: #F5F7FF; background: #202D52; border-color: #6D7CFF; }
QLabel[statusChip="true"] {
    background: #141D32;
    border: 1px solid #2B3855;
    border-radius: 9px;
    padding: 4px 12px;
    color: #B7C1D9;
    font-size: 11px;
    font-weight: 650;
}
QLabel[statusChip="true"][state="ok"] {
    color: #34D399;
    background: #2A3A2A;
    border-color: #3A5A3A;
}
QLabel[statusChip="true"][state="warning"] {
    color: #FBBF24;
    background: #1A253D;
    border-color: #FBBF24;
}
QLabel[statusChip="true"][state="error"] {
    color: #FB7185;
    background: #321827;
    border-color: #8E2C52;
}
QLabel[statusChip="true"][state="muted"] {
    color: #7F8BA6;
    background: #1A253D;
    border-color: #2B3855;
}

/* Page structures */
QFrame#page_header { background: transparent; border: 0; }
QLabel[pageTitle="true"] { font-size: 23px; font-weight: 650; }
QLabel[pageSubtitle="true"] { color: #7F8BA6; font-size: 12px; }
QLabel[dialogTitle="true"] { font-size: 18px; font-weight: 700; color: #F5F7FF; }
QLabel[dialogTitleLarge="true"] { font-size: 20px; font-weight: 700; color: #F5F7FF; }

QLabel[statusBadge="true"] { border-radius: 8px; padding: 0 12px; min-height: 28px; max-height: 28px; font-weight: 600; }
QLabel[capabilityBadge="true"] { border-radius: 8px; padding: 4px 10px; font-weight: 600; }
QLabel[statusBadge="true"][tone="success"], QLabel[capabilityBadge="true"][tone="success"] { background: #10382F; color: #6EE7B7; }
QLabel[statusBadge="true"][tone="warning"], QLabel[capabilityBadge="true"][tone="warning"] { background: #3B2E12; color: #FCD34D; }
QLabel[statusBadge="true"][tone="danger"], QLabel[capabilityBadge="true"][tone="danger"] { background: #3D1E2A; color: #FDA4AF; }
QLabel[statusBadge="true"][tone="info"], QLabel[capabilityBadge="true"][tone="info"] { background: #132D42; color: #7DD3FC; }
QLabel[statusBadge="true"][tone="muted"], QLabel[capabilityBadge="true"][tone="muted"] { background: #1C263A; color: #9AA7C0; }
QFrame#page_toolbar, QFrame#filter_bar, QFrame#selection_bar { background: transparent; border: 0; }
QFrame#selection_bar { background: #172036; border: 1px solid #2D3B59; border-radius: 9px; }
QLabel#lbl_selection_count { color: #B7C1D9; font-weight: 650; }

/* Tables */
QTableView {
    background: #11182B;
    alternate-background-color: #11182B;
    border: 1px solid #2B3855;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #18243D;
    selection-color: #F5F7FF;
    outline: none;
}
QTableView:hover {
    border-color: #405171;
}
QTableView:focus { border-color: #8B9BFF; }
QTableView::item { border: 0; border-bottom: 1px solid #1A253D; padding: 0 12px; }
QTableView::item:hover { background: #141D32; }
QTableView::item:selected { background: #18243D; color: #F2F5FF; }
QListView, QTreeView {
    selection-background-color: #18243D;
    selection-color: #F2F5FF;
    outline: none;
}
QListView::item:selected, QTreeView::item:selected { background: #18243D; color: #F2F5FF; }
QHeaderView::section {
    min-height: 40px;
    background: #141D32;
    color: #B7C1D9;
    border: 0;
    border-bottom: 1px solid #2B3855;
    padding: 0 12px;
    font-weight: 650;
}
QHeaderView::section:hover {
    background: #1A253D;
}
QTableCornerButton::section {
    background: #141D32;
    border: 0;
    border-bottom: 1px solid #2B3855;
}

/* Tabs */
QTabWidget::pane { border: 0; background: transparent; top: -1px; }
QTabBar::tab {
    background: transparent;
    color: #94A3B8;
    border: 0;
    padding: 10px 16px;
    margin-right: 3px;
    font-weight: 550;
    border-radius: 12px 12px 0 0;
}
QTabBar::tab:hover {
    color: #B7C1D9;
    background: rgba(255, 255, 255, 26);
}
QTabBar::tab:selected {
    color: #6D7CFF;
    border-bottom: 2px solid #8B9BFF;
    background: rgba(109, 124, 255, 26);
}
QTabWidget#tab_settings QTabBar::tab {
    min-width: 150px;
    text-align: left;
    padding: 12px 16px;
    border-radius: 10px;
    margin: 2px 8px 2px 0;
}
QTabWidget#tab_settings QTabBar::tab:selected {
    background: #1B2341;
    border: 0;
    border-left: 2px solid #8B7CFF;
    color: #C4B5FD;
}
QWidget#page_settings { background: #0B1020; }
QLineEdit#le_settings_search:focus { border-color: #8B7CFF; background: #11182B; }
QTabWidget#tab_settings::pane { background: #11182B; border: 1px solid #313B5B; border-top: 2px solid #8B7CFF; border-radius: 14px; }
QScrollArea#settings_tab_scroll { background: #11182B; border: 0; }
QScrollArea#settings_tab_scroll > QWidget > QWidget, QWidget#settings_tab_page { background: #11182B; }

/* Cards and summaries */
QFrame[summaryCard="true"] {
    background: #11182B;
    border: 1px solid #2B3855;
    border-radius: 16px;
    border-top: 3px solid #8B9BFF;
}
QFrame[summaryCard="true"]:hover {
}
QLabel[summaryLabel="true"] {
    color: #8B9BFF;
    font-size: 11px;
    font-weight: 700;
    font-size: 10px;
}
QLabel[summaryValue="true"] {
    font-size: 32px;
    font-weight: 700;
    color: #6D7CFF;
}
QLabel[summaryMetric="true"] {
    color: #94A3B8;
    font-size: 12px;
}

/* Colorful dashboard metric cards: tinted surface + colored top accent. */
QFrame[accentCard="true"] {
    border-radius: 16px;
    border: 1px solid #2B3855;
}
QFrame[accentCard="true"][accent="primary"] {
    background: #141D32;
    border-top: 3px solid #8B9BFF;
}
QFrame[accentCard="true"][accent="success"] {
    background: #11182B;
    border-top: 3px solid #34D399;
}
QFrame[accentCard="true"][accent="warning"] {
    background: #141D32;
    border-top: 3px solid #FBBF24;
}
QFrame[accentCard="true"][accent="danger"] {
    background: #141D32;
    border-top: 3px solid #FB7185;
}
QFrame[accentCard="true"][accent="purple"] {
    background: #141D32;
    border-top: 3px solid #22D3EE;
}
QFrame[accentCard="true"][accent="info"] {
    background: #11182B;
    border-top: 3px solid #22D3EE;
}
QLabel[accentLabel="true"] {
    font-size: 11px;
    font-weight: 800;
    color: #8B9BFF;
}
QLabel[accentValue="true"] {
    font-size: 32px;
    font-weight: 800;
    color: #F5F7FF;
}
QLabel[accentValue="true"][accent="primary"] { color: #8B9BFF; }
QLabel[accentValue="true"][accent="success"] { color: #34D399; }
QLabel[accentValue="true"][accent="warning"] { color: #FBBF24; }
QLabel[accentValue="true"][accent="danger"] { color: #FB7185; }
QLabel[accentValue="true"][accent="purple"] { color: #22D3EE; }
QLabel[accentValue="true"][accent="info"] { color: #22D3EE; }

QFrame[systemBanner="true"] { background: #0E2C33; border: 1px solid #1D5A66; border-radius: 10px; }
QLabel[systemBannerText="true"] { font-weight: 650; color: #67E8F9; }
QFrame[systemBanner="true"][state="attention"] { background: #382D16; border-color: #765D20; }
QFrame[systemBanner="true"][state="attention"] QLabel[systemBannerText="true"] { color: #FCD34D; }
QPushButton#btn_dashboard_review_attention { min-height: 28px; padding: 0 9px; color: #FCD34D; }
QFrame#account_pool_summary { background: #11182B; border: 1px solid #2B3855; border-radius: 12px; }
QWidget[accountSummaryItem="true"] { background: transparent; border: 0; }
QLabel[accountSummaryLabel="true"] { color: #7F8BA6; font-size: 11px; }
QLabel[summaryValueSmall="true"] { font-size: 15px; font-weight: 750; color: #D8D2F8; }
QLabel[summaryValueSmall="true"][tone="success"] { color: #34D399; }
QLabel[summaryValueSmall="true"][tone="warning"] { color: #FBBF24; }
QLabel[summaryValueSmall="true"][tone="danger"] { color: #FDA4AF; }
QLabel[summaryValueSmall="true"][tone="primary"] { color: #8B9BFF; }
QLabel[summaryValueSmall="true"][tone="purple"] { color: #67E8F9; }
QLabel[summaryValueSmall="true"][tone="muted"] { color: #8D99B2; }

/* Color-coded high-value actions keep dense multi-account screens scannable. */
QPushButton#btn_account_pool_safety {
    background: #141D32;
    border-color: #405171;
    color: #8B9BFF;
}
QPushButton#btn_account_pool_safety:hover {
    background: #1A253D;
    border-color: #7E56C9;
}
QPushButton#btn_create_target_invite_link {
    background: #11182B;
    border-color: #2B3855;
    color: #34D399;
}
QPushButton#btn_create_target_invite_link:hover {
    background: #141D32;
    border-color: #405171;
}
QPushButton#btn_create_target_campaign {
    background: #141D32;
    border-color: #2B3855;
    color: #22D3EE;
}
QPushButton#btn_create_target_campaign:hover {
    background: #1A253D;
    border-color: #405171;
}
QPushButton#btn_add_target_group, QPushButton#btn_add_source_group {
    background: #141D32;
    border-color: #405171;
    color: #FBBF24;
}
QPushButton#btn_add_target_group:hover, QPushButton#btn_add_source_group:hover {
    background: #1A253D;
    border-color: #7E56C9;
}
QPushButton#btn_target_more_actions, QPushButton#btn_source_more_actions {
    background: #11182B;
    border-color: #2B3855;
    color: #B7C1D9;
}
QPushButton#btn_target_more_actions:hover, QPushButton#btn_source_more_actions:hover {
    background: #141D32;
    border-color: #405171;
}

/* ---------- Toast & loading ---------- */
QFrame#toast_notification {
    background: rgba(255, 255, 255, 242);
    border: 1px solid #8B9BFF;
    border-radius: 16px;
}
QLabel#lbl_toast_title {
    font-weight: 650;
    color: #6D7CFF;
}
QLabel#lbl_toast_description {
    color: #94A3B8;
}
QWidget#loading_overlay {
    background: rgba(255, 255, 255, 26);
}
QFrame#loading_card {
    background: #141D32;
    border: 1px solid #2B3855;
    border-radius: 16px;
}
QProgressBar#loading_spinner {
    background: #1A253D;
    border: 0;
    border-radius: 2px;
}
QProgressBar#loading_spinner::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B9BFF, stop:1 #6D7CFF);
    border-radius: 2px;
}

/* Empty state */
QFrame#empty_state {
    background: transparent;
    border: 1px dashed #8B9BFF;
    border-radius: 16px;
    padding: 32px;
    text-align: center;
}
QLabel#lbl_empty_icon {
    color: #6D7CFF;
    font-size: 48px;
    margin-bottom: 16px;
}
QLabel#lbl_empty_title {
    font-size: 18px;
    font-weight: 650;
    color: #6D7CFF;
    margin-bottom: 8px;
}
QLabel#lbl_empty_description {
    color: #94A3B8;
    font-size: 14px;
    max-width: 200px;
}

/* Pagination */
QFrame#pagination_bar { background: transparent; border: 0; }
QLabel#lbl_pagination_total, QLabel#lbl_pagination_page { color: #7F8BA6; }
QPushButton#btn_page_previous, QPushButton#btn_page_next { min-height: 32px; }
QSpinBox#spin_page_jump { min-height: 32px; max-height: 32px; border-radius: 7px; font-weight: 650; color: #EEF2FF; }
QSpinBox#spin_page_jump::up-button, QSpinBox#spin_page_jump::down-button { width: 0; border: 0; }

/* Toast & loading */
QFrame#toast_notification { background: #172036; border: 1px solid #2D3B59; border-radius: 11px; }
QLabel#lbl_toast_title { font-weight: 650; }
QLabel#lbl_toast_description { color: #B7C1D9; }
QWidget#loading_overlay { background: rgba(15, 11, 30, 185); }
QFrame#loading_card { background: #172036; border: 1px solid #2D3B59; border-radius: 12px; }
QProgressBar#loading_spinner { background: #18243C; border: 0; border-radius: 2px; }
QProgressBar#loading_spinner::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6D7CFF, stop:1 #22D3EE); border-radius: 2px; }

/* Switch widget */

/* High-contrast standard checkboxes (filters/dialogs/table-adjacent controls). */
QCheckBox, QRadioButton { background: transparent; }
QCheckBox { spacing: 9px; min-height: 24px; }
QCheckBox[optionControl="true"] { background: transparent; border: 0; padding: 2px 0; }
QCheckBox::indicator { width: 20px; height: 20px; border: 1px solid #405171; border-radius: 5px; background: #11182B; }
QCheckBox::indicator:hover { border-color: #7E5FC9; background: #172036; }
QCheckBox::indicator:checked { border-color: #776ADC; background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5146A4, stop:1 #126779); }
QCheckBox::indicator:disabled { border-color: #332A5C; background: #0F1728; }
QCheckBox[switch="true"] { spacing: 10px; }
QCheckBox[switch="true"]::indicator { width: 34px; height: 18px; border-radius: 9px; background: #2B3855; border: 0; }
QCheckBox[switch="true"]::indicator:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6D7CFF, stop:1 #22D3EE); }

QProgressBar { min-height: 8px; max-height: 8px; border: 0; border-radius: 4px; text-align: center; background: #26334D; color: transparent; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6D7CFF, stop:1 #22D3EE); border-radius: 4px; }
QLabel[tone="success"] { color: #34D399; }
QLabel[tone="warning"] { color: #FBBF24; }
QLabel[tone="danger"] { color: #FB7185; }
QLabel[tone="info"] { color: #7DD3FC; }
QLabel[tone="primary"] { color: #8B9BFF; }
QLabel[tone="purple"] { color: #67E8F9; }
QLabel[tone="muted"] { color: #7F8BA6; }
QCheckBox[switch="true"]::indicator { width: 0px; height: 0px; }

/* Phase 8.2 licensing */
QLabel[planBadge="true"] { background:#241A4D; color:#BEC7FF; border:1px solid #4C3A8C; border-radius:7px; padding:3px 7px; font-size:10px; font-weight:700; }
QFrame[pricingCard="true"] { background:#11182B; border:1px solid #2D3B59; border-radius:12px; }
QFrame[pricingCard="true"]:hover { border-color:#8B9BFF; }
QFrame[lockedFeature="true"] { background:#0F1728; border:1px solid #2B3855; border-radius:12px; }
QLabel[lockedTitle="true"], QLabel[sectionTitle="true"], QLabel[detailTitle="true"] { font-size:16px; font-weight:650; }
QLabel#lbl_loading_message { font-size:14px; font-weight:650; }

QPushButton#btn_license_status { min-height:30px; padding:0 9px; border-radius:7px; background:#11182B; border:1px solid #2D3B59; color:#B7C1D9; font-size:10px; font-weight:700; }
QPushButton#btn_license_status[state="ok"] { color:#34D399; border-color:#1F7A5C; }
QPushButton#btn_license_status[state="warning"] { color:#FBBF24; border-color:#8A6420; }
QPushButton#btn_license_status[state="error"] { color:#FB7185; border-color:#8E2C52; }

/* Phase 8.3 production polish */
QLabel { background: transparent; }
QWidget#summary_metrics_host, QWidget[transparentHost="true"] { background: transparent; border: 0; }
QWidget[metricTile="true"] { background: #0F1728; border: 1px solid #2B3855; border-radius: 8px; }
QLabel[metricValue="true"] { font-size: 18px; font-weight: 700; }
QLabel#lbl_summary_icon { color: #7F8BA6; }
QLabel[statusChip="true"], QPushButton#btn_license_status, QPushButton#btn_emergency_pause {
    min-height: 32px; max-height: 32px; padding: 0 12px; border-radius: 8px;
}
QProgressBar[tone="success"]::chunk { background: #34D399; }
QProgressBar[tone="warning"]::chunk { background: #FBBF24; }
QProgressBar[tone="danger"]::chunk { background: #FB7185; }
QProgressBar[tone="muted"]::chunk { background: #7F8BA6; }
QTabWidget#tab_settings QTabBar::tab { min-width: 150px; min-height: 38px; }

/* Premium license shell + celebration polish */
QPushButton#btn_license_status { min-width:84px; min-height:32px; max-height:32px; padding:0 12px; border-radius:9px; font-size:10px; font-weight:800; background:#151E34; border:1px solid #34415F; color:#C4CCDD; }
QPushButton#btn_license_status:hover { border-color:#7182FF; background:#1B2540; color:#FFFFFF; }
QPushButton#btn_license_status[state="ok"] { color:#CFFBE8; border-color:#1F9D70; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #12372F,stop:1 #18344B); }
QPushButton#btn_license_status[state="warning"] { color:#FFE7A6; border-color:#A97922; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #3A2C12,stop:1 #29263D); }
QPushButton#btn_license_status[state="error"] { color:#FFD1D9; border-color:#A13C5B; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #3B1827,stop:1 #2B1D38); }
QFrame[licenseHero="true"] { border:1px solid #38496C; border-top:3px solid #7C83FF; border-radius:14px; background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #121A30,stop:0.55 #11182B,stop:1 #102337); }
QFrame[pricingCard="true"][planTier="starter"] { border-top:2px solid #38BDF8; }
QFrame[pricingCard="true"][planTier="pro"] { border-top:2px solid #8B7CFF; }
QFrame[pricingCard="true"][planTier="ultimate"] { border-top:2px solid #22D3EE; }
QDialog#license_success_dialog { background:#0B1020; }
QFrame#license_success_hero { background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #19214A,stop:0.48 #102B3D,stop:1 #0E3A31); border:1px solid #3F5B73; border-radius:18px; }
QLabel[celebrationMark="true"] { color:#5EE6B1; font-size:38px; font-weight:900; }
QLabel[celebrationTitle="true"] { color:#FFFFFF; font-size:28px; font-weight:850; }
QLabel[celebrationSubtitle="true"] { color:#B8C6DD; font-size:13px; }
QLabel[celebrationPlan="true"] { color:#A9B4FF; font-size:20px; font-weight:800; }
QFrame[licenseMetric="true"] { background:#11182B; border:1px solid #2D3B59; border-radius:12px; }
QLabel[licenseMetricValue="true"] { color:#F5F7FF; font-size:17px; font-weight:800; }
QLabel[licenseMetricCaption="true"] { color:#7F8BA6; font-size:9px; font-weight:750; }
QLabel[celebrationNote="true"] { color:#91A1BC; padding:4px 10px; }
QPushButton#btn_success_continue { min-width:190px; min-height:40px; }
QPushButton#btn_success_view_license { min-height:40px; background:#121A2D; border-color:#354563; }

/* Smart Add Members simple flow */
QDialog#dlg_smart_add_members { background: #0B1120; }
QFrame#smart_add_hero {
    border: 1px solid #304565;
    border-left: 3px solid #22D3EE;
    border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #121B32,stop:0.55 #102239,stop:1 #0D2C36);
}
QLabel#smart_add_title { color: #F8FAFF; font-size: 23px; font-weight: 800; }
QLabel#smart_add_subtitle, QLabel#smart_add_muted { color: #93A4BF; }
QLabel#smart_add_caption { color: #7DD3FC; font-size: 10px; font-weight: 800; }
QLabel#smart_add_section_title { color: #F4F7FF; font-size: 15px; font-weight: 750; }
QLabel#smart_add_status {
    padding: 10px 12px; border-radius: 9px;
    background: #10192B; border: 1px solid #273650; color: #C6D2E6;
}
QFrame#smart_add_target_card {
    border: 1px solid #253650; border-radius: 12px; background: #0F1728;
}
QFrame[smartStage="true"] {
    border: 1px solid #273650; border-radius: 9px; background: #0E1729;
}
QLabel[stageBadge="true"] {
    min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px;
    border-radius: 12px; background: #182A43; color: #67E8F9; font-weight: 800;
}
QLabel[stageText="true"] { color: #B9C6D9; font-weight: 700; }
QFrame[smartMetric="true"] {
    border: 1px solid #293A55; border-radius: 11px; background: #10192B;
}
QLabel[metricCaption="true"] { color: #7F90AA; font-size: 10px; font-weight: 700; }
QLabel[metricValue="true"] { color: #F5F8FF; font-size: 20px; font-weight: 850; }
QPushButton#btn_smart_add_primary { min-width: 180px; min-height: 40px; }
QToolButton#btn_smart_add_advanced { color: #8FA1BC; border: 0; padding: 4px 2px; }
QPlainTextEdit#smart_add_advanced { background: #0D1525; border: 1px solid #253650; border-radius: 9px; color: #9FB0C8; }

/* Quick Add drag and drop flow */
QDialog#dlg_drag_drop_add { background: #0A1020; }
QFrame#quick_transfer_hero {
    border: 1px solid #2B4264; border-left: 3px solid #22D3EE; border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #111A31,stop:0.55 #10243B,stop:1 #0D3035);
}
QLabel#quick_transfer_title { color: #F7FAFF; font-size: 24px; font-weight: 850; }
QLabel#quick_transfer_subtitle { color: #9AACBF; }
QLabel#quick_transfer_instruction { color: #B6C5DB; font-size: 13px; font-weight: 750; padding: 6px; }
QFrame#quick_transfer_panel { background: #0E1728; border: 1px solid #263751; border-radius: 14px; }
QLabel#quick_transfer_panel_title { color: #EAF1FF; font-size: 13px; font-weight: 850; }
QFrame#drag_source_group_card, QFrame#drop_target_group_card { background: #111B2E; border: 1px solid #2A3A55; border-radius: 12px; }
QFrame#drag_source_group_card:hover { border-color: #6D7CFF; background: #142139; }
QFrame#drop_target_group_card:hover { border-color: #22B8D3; background: #102438; }
QFrame#drop_target_group_card[dropActive="true"] { border: 2px solid #22D3EE; background: #102B3C; }
QFrame#drop_target_group_card[recommendedTarget="true"] { border-color: #6EE7B7; }
QLabel[flowBadge="source"] { color: #C8C4FF; background: #25244A; border-radius: 7px; padding: 3px 7px; font-size: 9px; font-weight: 800; }
QLabel[flowBadge="target"] { color: #9FF3E1; background: #123B37; border-radius: 7px; padding: 3px 7px; font-size: 9px; font-weight: 800; }
QLabel[dropHint="true"] { color: #67E8F9; font-size: 9px; font-weight: 800; }
QLabel[flowCardTitle="true"] { color: #F2F6FF; font-size: 14px; font-weight: 800; }
QLabel[flowMuted="true"] { color: #8293AD; }
QLabel[flowCardMeta="true"] { color: #A7B7CD; font-size: 10px; }
QLabel[flowEmpty="true"] { color: #71819C; padding: 30px; }
QFrame#quick_transfer_center { background: transparent; border: 0; }
QLabel#quick_transfer_arrow { color: #5FE1F3; font-size: 20px; font-weight: 900; }
QFrame#quick_transfer_route { border: 1px solid #2B4264; border-radius: 12px; background: #101A2D; }
QLabel#quick_route_source { color: #C8C4FF; font-size: 15px; font-weight: 800; }
QLabel#quick_route_target { color: #9FF3E1; font-size: 15px; font-weight: 800; }
QLabel#quick_route_arrow { color: #5FE1F3; font-size: 24px; font-weight: 900; }
QLabel#quick_transfer_section_title { color: #EDF4FF; font-size: 14px; font-weight: 800; }
QFrame[flowMetric="true"] { background: #10192B; border: 1px solid #293A55; border-radius: 10px; }
QLabel[metricCaption="true"] { color: #7F90AA; font-size: 9px; font-weight: 700; }
QLabel[metricValue="true"] { color: #F6F8FF; font-size: 19px; font-weight: 850; }
QLabel#quick_transfer_status { padding: 10px 12px; border-radius: 9px; background: #101A2C; border: 1px solid #293A55; color: #C7D3E7; }
QPushButton#btn_quick_transfer_primary { min-width: 180px; min-height: 40px; }
QToolButton#btn_quick_transfer_advanced { color: #8FA1BC; border: 0; }
QPlainTextEdit#txt_quick_transfer_advanced { background: #0D1525; border: 1px solid #253650; border-radius: 9px; color: #9FB0C8; }

/* Automation Studio V2 */
QWidget#page_automation_studio { background: transparent; }
QFrame#studio_hero {
    border: 1px solid #294260; border-left: 3px solid #22D3EE; border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #101A30,stop:.55 #10243A,stop:1 #0D3035);
}
QLabel#studio_title { color: #F7FAFF; font-size: 24px; font-weight: 850; }
QLabel#studio_subtitle { color: #9AAEC6; }
QLabel#studio_instruction { color: #AFC1D8; font-size: 13px; font-weight: 800; padding: 4px; }
QFrame#studio_panel { background: #0E1728; border: 1px solid #263751; border-radius: 14px; }
QLabel#studio_panel_title { color: #EDF4FF; font-size: 13px; font-weight: 850; }
QLabel[studioMuted="true"] { color: #8091AA; }
QLabel[studioEmpty="true"] { color: #75859D; padding: 34px; }
QFrame#studio_center_lane { background: transparent; border: 0; }
QLabel#studio_route_arrow { color: #5FE1F3; font-size: 20px; font-weight: 900; }
QLabel#studio_status {
    padding: 10px 12px; border-radius: 9px; background: #101A2C;
    border: 1px solid #293A55; color: #C6D2E6;
}

/* Live member job UX v2 */
QFrame#live_job_chip {
    background: #0E1B2E;
    border: 1px solid #27405F;
    border-radius: 10px;
}
QFrame#live_job_chip[state="running"] {
    border-color: #22D3EE;
    background: #0C2430;
}
QFrame#live_job_chip[state="success"] {
    border-color: #34D399;
    background: #0D2A25;
}
QFrame#live_job_chip[state="warning"] {
    border-color: #F59E0B;
    background: #2A2010;
}
QFrame#live_job_chip[state="error"] {
    border-color: #FB7185;
    background: #2A151D;
}
QPushButton#btn_live_job_chip {
    border: 0;
    background: transparent;
    padding: 0px 5px;
    min-height: 24px;
    color: #D9F7FF;
    font-size: 11px;
    font-weight: 800;
}
QProgressBar#progress_live_job_chip {
    border: 0;
    background: #203049;
    border-radius: 1px;
}
QProgressBar#progress_live_job_chip::chunk {
    background: #22D3EE;
    border-radius: 1px;
}
QFrame#quick_live_activity {
    background: #0E182A;
    border: 1px solid #2C4363;
    border-left: 3px solid #22D3EE;
    border-radius: 11px;
}
QLabel#lbl_quick_live_pulse {
    color: #22D3EE;
    font-size: 22px;
    font-weight: 900;
}
QLabel#lbl_quick_live_title {
    color: #F5F9FF;
    font-size: 12px;
    font-weight: 850;
}
QLabel#lbl_quick_live_member {
    color: #DCEBFF;
    font-size: 12px;
    font-weight: 750;
}
QLabel#lbl_quick_live_account {
    color: #7DD3FC;
    font-size: 11px;
    font-weight: 750;
}
QLabel#lbl_quick_live_feed {
    color: #8EA3BE;
    font-size: 10px;
}
QPushButton#btn_quick_background {
    min-height: 32px;
    padding: 5px 12px;
    border: 1px solid #355170;
    border-radius: 8px;
    background: #111F34;
    color: #D7E6F8;
}
QPushButton#btn_quick_background:hover {
    border-color: #22D3EE;
    background: #10283A;
}

/* Group Board UX V2 */
QFrame#group_board_intro { background: #0D1A2D; border: 1px solid #233A58; border-left: 3px solid #22D3EE; border-radius: 12px; }
QLabel#lbl_group_board_heading { color: #F5F9FF; font-size: 20px; font-weight: 900; }
QLabel#lbl_group_board_description, QLabel#lbl_group_board_footer, QLabel#lbl_group_lane_subtitle { color: #8EA6C5; }
QLineEdit#le_group_board_search { min-height: 38px; border: 1px solid #2D4564; border-radius: 9px; background: #101B2D; padding: 0 11px; }
QFrame#group_board_lane { background: #0C1525; border: 1px solid #243750; border-radius: 12px; }
QFrame#group_board_lane[dropActive="true"] { border: 2px solid #22D3EE; background: #0B2230; }
QLabel#lbl_group_lane_title { color: #EAF3FF; font-size: 12px; font-weight: 900; }
QLabel#lbl_group_lane_count { color: #7DD3FC; background: #102B3A; border: 1px solid #1D5369; border-radius: 9px; padding: 2px 7px; font-weight: 850; }
QLabel#lbl_group_lane_drop_hint { color: #67E8F9; background: #0A1C2A; border: 1px dashed #2B6074; border-radius: 8px; font-size: 9px; font-weight: 850; }
QFrame#group_board_card { background: #111D31; border: 1px solid #263B59; border-radius: 10px; }
QFrame#group_board_card:hover { border-color: #38BDF8; background: #12233A; }
QFrame#group_board_card[role="source"] { border-left: 3px solid #A78BFA; }
QFrame#group_board_card[role="target"] { border-left: 3px solid #34D399; }
QLabel#lbl_group_board_title { color: #F4F8FF; font-size: 12px; font-weight: 850; }
QLabel#lbl_group_board_subtitle { color: #7DD3FC; }
QLabel#lbl_group_board_meta { color: #8299B8; font-size: 10px; }
QLabel#lbl_group_board_badge { color: #D8E7FB; background: #182841; border: 1px solid #2A4162; border-radius: 7px; padding: 2px 6px; font-size: 8px; font-weight: 900; }

/* Add Member One-Board UX */
QWidget#page_add_member { background: transparent; }
QFrame#add_member_hero {
    border: 1px solid #2A4363; border-left: 3px solid #22D3EE; border-radius: 14px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #111B31,stop:.58 #10253B,stop:1 #0D3035);
}
QLabel#add_member_title { color: #F6FAFF; font-size: 24px; font-weight: 900; }
QLabel#add_member_subtitle { color: #9DB0C8; }
QFrame#add_member_board_bar, QFrame#group_library_bar {
    background: #0E182A; border: 1px solid #273B57; border-radius: 11px;
}
QLabel#lbl_add_member_board_title, QLabel#lbl_group_library_heading { color: #EDF5FF; font-size: 15px; font-weight: 900; }
QLabel#lbl_add_member_board_hint, QLabel#lbl_add_member_page_status, QLabel#lbl_group_library_hint { color: #8EA4C1; }
QLabel#lbl_add_member_selection {
    color: #C6D6EA; background: #0D1728; border: 1px solid #263A56; border-radius: 9px; padding: 9px 11px;
}
QFrame#add_member_group_card, QFrame#group_library_card {
    background: #111D31; border: 1px solid #2A3D5B; border-radius: 11px;
}
QFrame#add_member_group_card:hover, QFrame#group_library_card:hover { border-color: #38BDF8; background: #12233A; }
QFrame#add_member_group_card[selectedSource="true"] { border: 2px solid #A78BFA; background: #1A1D3B; }
QFrame#add_member_group_card[dropActive="true"] { border: 2px solid #34D399; background: #0F2A29; }
QLabel#lbl_add_member_group_title, QLabel#lbl_group_library_title { color: #F4F8FF; font-size: 13px; font-weight: 850; }
QLabel#lbl_add_member_group_username, QLabel#lbl_group_library_username { color: #7DD3FC; }
QLabel#lbl_add_member_group_meta, QLabel#lbl_group_library_meta { color: #8299B8; font-size: 10px; }
QLabel#lbl_add_member_group_drag {
    color: #67E8F9; background: #102A39; border: 1px solid #24596D;
    border-radius: 7px; padding: 2px 7px; font-size: 8px; font-weight: 900;
}

/* Add Member Left Right V2 */
QFrame#add_member_column {
    background: #0C1525;
    border: 1px solid #253852;
    border-radius: 12px;
}
QLabel#lbl_add_member_column_title {
    color: #F2F7FF;
    font-size: 13px;
    font-weight: 900;
}
QLabel#lbl_add_member_column_subtitle {
    color: #8499B5;
}
QFrame#add_member_source_card,
QFrame#add_member_target_card {
    background: #111D31;
    border: 1px solid #2A3D5B;
